# Salin jadi .env.local lalu isi.
# Email yang otomatis jadi admin (guru) saat mendaftar. Pisahkan dengan koma.
ADMIN_EMAILS=guru@contoh.com
# Kode kelas yang diminta saat murid mendaftar.
EXACT_KODE_KELAS=EXACT2026
# Exact Worksheet (pembuat soal & pencetak PDF) di Mac yang sama.
EXACT_WORKSHEET_URL=http://127.0.0.1:7790
# Exact Canvas (murid bertanya → kanvas guru).
EXACT_CANVAS_URL=http://127.0.0.1:4747
EXACT_CANVAS_PUBLIC=https://meet2.exactprintsolution.com
# PIN berbagi Exact Canvas (Pengaturan → berbagi_pin). Jangan di-commit.
EXACT_CANVAS_PIN=
