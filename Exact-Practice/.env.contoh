# Salin jadi .env.local lalu isi. File .env.local TIDAK di-commit.

# ---------- Akun ----------
# Username yang otomatis jadi guru/admin saat mendaftar. Pisahkan dengan koma.
# (ADMIN_EMAILS lama masih dibaca.) Admin lain bisa dinaikkan dari /admin/peserta.
ADMIN_USERNAMES=

# ---------- Alamat ----------
NEXT_PUBLIC_SITE_URL=http://localhost:8770
EXACT_PRACTICE_PUBLIC=http://localhost:8770

# ---------- Exact Worksheet (pembuat soal & pencetak PDF, Mac yang sama) ----------
EXACT_WORKSHEET_URL=http://127.0.0.1:7790
# Kunci bersama untuk menerima paket dari Worksheet: samakan dengan "kunci" di
# ~/Library/Application Support/Exact Worksheet/practice.json
EXACT_PRACTICE_KUNCI=

# ---------- Exact Canvas (Tanya guru, papan guru, masuk dengan akun Canvas) ----------
EXACT_CANVAS_URL=http://127.0.0.1:4747
# Alamat Canvas yang dibuka browser murid (domain Tunnel Canvas milikmu).
EXACT_CANVAS_PUBLIC=http://localhost:4747
# PIN berbagi Canvas (Settings → Share on this network).
EXACT_CANVAS_PIN=

# ---------- Opsional (warisan Exact Try Out, tidak dipakai mode berkas) ----------
# Diisi = pindah ke mode Supabase. Biarkan kosong.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Pembuat soal AI di /admin/soal (warisan Try Out).
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
