# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # server only, JANGAN pernah di-expose ke client

# ---------- Admin ----------
# Email di daftar ini otomatis berperan admin saat akunnya dibuat.
# Cara membuat admin pertama tanpa menyentuh basis data. Pisahkan dengan koma.
ADMIN_EMAILS=

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Exact Try Out

# ---------- Payment: transfer bank manual (cara paling sederhana) ----------
# Diisi = tombol "Transfer bank" muncul di /paket. Dikosongkan = tombol itu
# tidak ada sama sekali (lebih baik daripada menampilkan rekening kosong).
# Setelah pembeli transfer dan mengabari admin, admin menekan "Tandai lunas"
# di /admin/pesanan — kuotanya lahir di situ, bukan dari peramban pembeli.
NEXT_PUBLIC_BANK_NAME=              # mis. BCA
NEXT_PUBLIC_BANK_ACCOUNT=           # mis. 1234567890
NEXT_PUBLIC_BANK_HOLDER=            # mis. PT Exact Group Indonesia
NEXT_PUBLIC_ADMIN_WHATSAPP=         # mis. +6281234567890 — tombol "Kirim bukti"
NEXT_PUBLIC_ADMIN_EMAIL=            # opsional, alternatif WhatsApp

# ---------- Payment: Stripe (internasional, semua mata uang selain IDR) ----------
STRIPE_SECRET_KEY=              # dashboard.stripe.com/apikeys
STRIPE_WEBHOOK_SECRET=          # whsec_... dari endpoint webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Payment: Midtrans Snap (khusus rupiah / Indonesia) ----------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ---------- Email transaksional ----------
# Struk pembelian dan surat pengembalian dana. Peserta masuk lewat Google, jadi
# tidak ada kode OTP yang perlu dikirim. Kosong = surat tidak dikirim; alur
# pembelian tetap berjalan.
RESEND_API_KEY=
EMAIL_FROM="Exact Try Out <noreply@exacttryout.com>"

# ---------- Pembuat soal AI ----------
# Isi salah satu atau semuanya. Penyedia yang kuncinya kosong akan tampil
# nonaktif di /admin/soal, tetapi tombol "Salin prompt" tetap berfungsi.
ANTHROPIC_API_KEY=            # Claude   - console.anthropic.com/settings/keys
GOOGLE_API_KEY=               # Gemini   - aistudio.google.com/apikey
OPENAI_API_KEY=               # ChatGPT  - platform.openai.com/api-keys
